<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/CardViewStyle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="16dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <ImageView
            android:id="@+id/ivHistoryCategoryIcon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_stat_blue"
            android:padding="10dp"
            android:src="@drawable/ic_phone"
            app:tint="@color/primary_blue"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvHistoryDateTime"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            tools:text="18 Sep 2025 | 10:30 AM"
            app:layout_constraintEnd_toStartOf="@+id/tvHistoryBadge"
            app:layout_constraintStart_toEndOf="@+id/ivHistoryCategoryIcon"
            app:layout_constraintTop_toTopOf="@+id/ivHistoryCategoryIcon" />

        <TextView
            android:id="@+id/tvHistoryBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_in"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="2dp"
            android:textColor="@color/badge_in_text"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="IN"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/ivHistoryCategoryIcon" />

        <TextView
            android:id="@+id/tvHistoryItemTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="8dp"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="Mobile Phone (Samsung Galaxy S23)"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/ivHistoryCategoryIcon"
            app:layout_constraintTop_toBottomOf="@+id/tvHistoryDateTime" />

        <TextView
            android:id="@+id/tvHistoryCustomerSub"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="8dp"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            tools:text="Rahul Sharma | Repair"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/ivHistoryCategoryIcon"
            app:layout_constraintTop_toBottomOf="@+id/tvHistoryItemTitle" />

        <TextView
            android:id="@+id/tvHistoryDatesInOut"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="8dp"
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            tools:text="IN: 18 Sep 2025 | OUT: -"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/ivHistoryCategoryIcon"
            app:layout_constraintTop_toBottomOf="@+id/tvHistoryCustomerSub" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
